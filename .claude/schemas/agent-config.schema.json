{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-config.schema.json",
  "title": "PRD Starter Agent Configuration Schema",
  "description": "JSON schema for validating agent configurations generated by PRD Starter",
  "type": "object",
  "required": ["agents", "project", "orchestration"],
  "properties": {
    "project": {
      "type": "object",
      "description": "Project information",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Project identifier (alphanumeric, hyphens, underscores)"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Project description (at least 10 characters)"
        },
        "type": {
          "type": "string",
          "enum": ["web", "game", "mobile", "backend", "data", "devops", "other"],
          "description": "Project type category"
        }
      }
    },
    "agents": {
      "type": "array",
      "description": "List of agent configurations",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "displayName", "role"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "description": "Agent identifier (lowercase, hyphens, underscores)"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable agent name"
          },
          "role": {
            "type": "string",
            "enum": ["pm", "developer", "qa", "techartist", "gamedesigner", "custom"],
            "description": "Agent role type"
          },
          "icon": {
            "type": "string",
            "description": "ASCII art icon (3-6 lines)"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Number of parallel instances"
          },
          "primaryResponsibility": {
            "type": "string",
            "minLength": 10,
            "description": "What this agent primarily does"
          },
          "cannotDo": {
            "type": "array",
            "description": "List of things this agent should not do",
            "items": { "type": "string" },
            "minItems": 1
          },
          "worksWith": {
            "type": "array",
            "description": "List of other agent roles this agent collaborates with",
            "items": { "type": "string" }
          },
          "mayWrite": {
            "type": "array",
            "description": "File paths this agent may write to",
            "items": { "type": "string" }
          },
          "mayNotWrite": {
            "type": "array",
            "description": "File paths this agent may NOT write to",
            "items": { "type": "string" }
          },
          "mcpServers": {
            "type": "array",
            "description": "List of MCP server names",
            "items": {
              "type": "string",
              "enum": [
                "filesystem",
                "github",
                "web-search",
                "brave-search",
                "playwright",
                "vision",
                "blender",
                "shadertoy",
                "image-process",
                "memory"
              ]
            }
          },
          "skills": {
            "type": "array",
            "description": "List of skill names this agent has access to",
            "items": { "type": "string" }
          },
          "subAgents": {
            "type": "array",
            "description": "List of sub-agent names for delegation",
            "items": { "type": "string" }
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "description": "Orchestration configuration",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["event-driven", "sequential", "hitl"],
          "description": "Session orchestration mode"
        }
      }
    },
    "workflow": {
      "type": "object",
      "description": "Workflow pattern configuration",
      "required": ["pattern"],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": ["waterfall", "collaborative", "autonomous", "custom"],
          "description": "How agents coordinate with each other"
        },
        "customDescription": {
          "type": "string",
          "description": "Description for custom workflow pattern"
        }
      }
    },
    "technology": {
      "type": "object",
      "description": "Technology stack configuration",
      "properties": {
        "frontend": {
          "type": "string",
          "description": "Frontend framework (e.g., React, Vue, Svelte)"
        },
        "backend": {
          "type": "string",
          "description": "Backend framework (e.g., Node.js, Python, Go)"
        },
        "database": {
          "type": "string",
          "description": "Database (e.g., PostgreSQL, MongoDB, Redis)"
        },
        "buildTools": {
          "type": "string",
          "description": "Build tools (e.g., Vite, Webpack, esbuild)"
        },
        "testing": {
          "type": "string",
          "description": "Testing framework (e.g., Jest, Playwright, Cypress)"
        }
      }
    },
    "qualityStandards": {
      "type": "object",
      "description": "Quality requirements",
      "properties": {
        "typescript": {
          "type": "boolean",
          "description": "Require TypeScript strict mode"
        },
        "testCoverage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum test coverage percentage"
        },
        "linting": {
          "type": "boolean",
          "description": "Enforce linting and formatting"
        },
        "precommit": {
          "type": "boolean",
          "description": "Require pre-commit hooks"
        },
        "cicd": {
          "type": "boolean",
          "description": "CI/CD pipeline integration required"
        },
        "documentation": {
          "type": "boolean",
          "description": "Documentation required for all code"
        },
        "security": {
          "type": "boolean",
          "description": "Security scanning required"
        },
        "performance": {
          "type": "boolean",
          "description": "Performance benchmarks required"
        }
      }
    },
    "features": {
      "type": "array",
      "description": "Initial feature list",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Feature title"
          },
          "description": {
            "type": "string",
            "description": "Feature description"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "default": "medium",
            "description": "Feature priority"
          },
          "category": {
            "type": "string",
            "enum": ["architectural", "functional", "integration", "polish", "design", "visual"],
            "default": "functional",
            "description": "Feature category"
          },
          "acceptanceCriteria": {
            "type": "array",
            "description": "List of acceptance criteria",
            "items": { "type": "string" }
          },
          "agent": {
            "type": "string",
            "description": "Agent assigned to this feature"
          }
        }
      }
    }
  }
}
