{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prd-starter-state.schema.json",
  "title": "PRD Starter State File Schema v3.1",
  "description": "JSON schema for the prd-starter state file with Quick Start, Standard, and Expert modes",
  "type": "object",
  "required": ["version", "startedAt", "currentPhase"],
  "properties": {
    "version": {
      "type": "string",
      "description": "State file version",
      "pattern": "^3\\.0\\."
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the session started"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When the session completed"
    },
    "wizardMode": {
      "type": "string",
      "enum": ["quick-start", "standard", "expert"],
      "description": "Wizard configuration mode"
    },
    "selectedPreset": {
      "type": ["string", "null"],
      "enum": [
        "indie-game-dev",
        "game-studio",
        "mobile-game",
        "multiplayer-arena",
        "modern-web-app",
        "full-stack-saas",
        "dashboard-analytics",
        "content-platform",
        "ecommerce-store",
        "saas-product",
        "enterprise-suite",
        "api-server",
        "data-ml-pipeline",
        "devops-infrastructure",
        "custom",
        null
      ],
      "description": "Selected preset name (Quick Start mode)"
    },
    "presetCustomizations": {
      "type": "object",
      "description": "Customizations applied to preset",
      "properties": {
        "additionalSkills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "removedSkills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "additionalSubAgents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "removedSubAgents": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "currentPhase": {
      "type": "string",
      "enum": [
        "entry_point_selection",
        "preset_selection",
        "project_identity",
        "project_scope",
        "agent_selection",
        "skill_configuration",
        "subagent_configuration",
        "orchestration_configuration",
        "mcp_configuration",
        "quality_standards",
        "initial_features",
        "review_generate",
        "project_initialization",
        "completed"
      ],
      "description": "Current active phase"
    },
    "currentSubPhase": {
      "type": ["string", "null"],
      "description": "Current sub-phase for multi-step phases"
    },
    "project": {
      "type": "object",
      "description": "Project configuration",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Project name"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Project description"
        },
        "category": {
          "type": "string",
          "enum": [
            "game-development",
            "web-application",
            "mobile-app",
            "api-backend",
            "data-ml",
            "ecommerce",
            "saas",
            "devops-infrastructure",
            "other"
          ],
          "description": "Project category"
        },
        "customCategory": {
          "type": "string",
          "description": "Custom category if 'other' selected"
        },
        "techStack": {
          "type": "string",
          "description": "Primary technology stack"
        },
        "customTechStack": {
          "type": "string",
          "description": "Custom tech stack if 'Custom' selected"
        },
        "teamSize": {
          "type": "string",
          "enum": ["solo", "small-team", "medium-team", "enterprise"],
          "description": "Team size"
        },
        "projectScale": {
          "type": "string",
          "enum": ["prototype-mvp", "startup-product", "production-system"],
          "description": "Project scale"
        },
        "successFactors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "speed-to-market",
              "code-quality",
              "visual-excellence",
              "multiplayer-reliability",
              "mobile-performance",
              "accessibility",
              "seo-optimization",
              "real-time-features",
              "data-processing"
            ]
          },
          "description": "Critical success factors"
        }
      }
    },
    "agents": {
      "type": "object",
      "description": "Agent configurations",
      "properties": {
        "pm": {
          "$ref": "#/definitions/agentConfig"
        },
        "developer": {
          "$ref": "#/definitions/agentConfig"
        },
        "techartist": {
          "$ref": "#/definitions/agentConfig"
        },
        "qa": {
          "$ref": "#/definitions/agentConfig"
        },
        "gamedesigner": {
          "$ref": "#/definitions/agentConfig"
        }
      }
    },
    "orchestration": {
      "type": "object",
      "description": "Orchestration settings",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["event-driven", "sequential", "polling", "hitl"],
          "description": "Orchestration mode"
        },
        "maxIterations": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000,
          "description": "Max iterations before auto-stop"
        },
        "contextResetThreshold": {
          "type": "integer",
          "default": 70,
          "minimum": 50,
          "maximum": 90,
          "description": "Context reset threshold percentage"
        }
      }
    },
    "qualityStandards": {
      "type": "object",
      "description": "Quality standards",
      "properties": {
        "typescriptStrictness": {
          "type": "string",
          "enum": ["strict", "standard", "loose"],
          "default": "strict"
        },
        "testCoverageTarget": {
          "type": "integer",
          "enum": [95, 80, 60, 0],
          "default": 80
        },
        "lintRules": {
          "type": "string",
          "enum": ["eslint-recommended", "custom", "none"],
          "default": "eslint-recommended"
        },
        "commitConvention": {
          "type": "string",
          "enum": ["ralph", "conventional", "custom"],
          "default": "ralph"
        },
        "cicdIntegration": {
          "type": "string",
          "enum": ["github-actions", "gitlab-ci", "none"],
          "default": "github-actions"
        },
        "noAnyTypes": {
          "type": "boolean",
          "default": true
        },
        "noTsIgnore": {
          "type": "boolean",
          "default": true
        },
        "allFeedbackLoopsMustPass": {
          "type": "boolean",
          "default": true
        },
        "visualRegressionTesting": {
          "type": "boolean",
          "default": false
        },
        "serverAuthoritativeValidation": {
          "type": "boolean",
          "default": false
        },
        "mobilePerformanceChecks": {
          "type": "boolean",
          "default": false
        },
        "accessibilityAuditing": {
          "type": "boolean",
          "default": false
        },
        "securityScanning": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "features": {
      "type": "array",
      "description": "Parsed PRD features",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^^(feat|fix|chore|test|arch|doc)-\\d+$"
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "enum": ["architectural", "functional", "integration", "chore", "design", "visual"]
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "agent": {
            "type": "string",
            "enum": ["pm", "developer", "techartist", "qa", "gamedesigner"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed"],
            "default": "pending"
          },
          "passes": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["id", "title", "description", "priority", "category", "agent"]
      }
    },
    "projectInitialization": {
      "type": "object",
      "description": "Project initialization state and configuration",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "failed", "skipped"],
          "default": "pending",
          "description": "Current initialization status"
        },
        "scriptPath": {
          "type": "string",
          "description": "Path to initialization script relative to project root"
        },
        "attempts": {
          "type": "integer",
          "default": 0,
          "maximum": 3,
          "description": "Number of initialization attempts made"
        },
        "maxAttempts": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of retry attempts"
        },
        "lastAttemptAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp of last initialization attempt"
        },
        "completedAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp when initialization completed successfully"
        },
        "error": {
          "type": ["string", "null"],
          "description": "Error message if initialization failed"
        },
        "errorDetails": {
          "type": ["string", "null"],
          "description": "Detailed error output for debugging"
        },
        "autoInitialize": {
          "type": "boolean",
          "default": true,
          "description": "Whether coordinator should auto-run initialization"
        },
        "techStack": {
          "type": "object",
          "description": "Technology stack configuration for initialization",
          "properties": {
            "runtime": {
              "type": "string",
              "enum": ["node", "python", "rust", "go", "java", "dotnet", "other"],
              "description": "Primary runtime environment"
            },
            "packageManager": {
              "type": "string",
              "description": "Package manager command (npm, yarn, pnpm, pip, poetry, cargo, go mod, etc.)"
            },
            "framework": {
              "type": "string",
              "description": "Framework name (react, vue, svelte, fastapi, django, etc.)"
            },
            "language": {
              "type": "string",
              "description": "Programming language (typescript, python, rust, go, etc.)"
            },
            "devCommand": {
              "type": "string",
              "description": "Command to start development server"
            },
            "buildCommand": {
              "type": "string",
              "description": "Command to build project"
            },
            "testCommand": {
              "type": "string",
              "description": "Command to run tests"
            },
            "installCommand": {
              "type": "string",
              "description": "Command to install dependencies"
            },
            "initCommand": {
              "type": "string",
              "description": "Command to initialize new project"
            }
          }
        },
        "feedbackLoops": {
          "type": "object",
          "description": "Feedback loop commands for quality checks",
          "properties": {
            "typeCheck": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            },
            "lint": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            },
            "test": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            },
            "build": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "phases": {
      "type": "object",
      "description": "Legacy phase tracking (deprecated in v3.0 but kept for compatibility)"
    }
  },
  "definitions": {
    "agentConfig": {
      "type": "object",
      "description": "Individual agent configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether this agent is enabled"
        },
        "display_name": {
          "type": "string",
          "description": "Agent display name"
        },
        "role": {
          "type": "string",
          "enum": ["pm", "developer", "techartist", "qa", "gamedesigner"],
          "description": "Agent role type"
        },
        "primary_responsibility": {
          "type": "string",
          "description": "Primary responsibility statement"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of skill names"
        },
        "subAgents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of sub-agent names"
        },
        "mcpServers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["github", "filesystem", "web-search", "brave-search", "playwright", "vision", "blender", "shadertoy", "image-process"]
          },
          "description": "List of MCP server names"
        },
        "may_write": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths this agent may write to"
        },
        "may_not_write": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths this agent may not write to"
        },
        "cannot_do": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Things this agent cannot do"
        },
        "works_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other agents this works with"
        }
      },
      "required": ["enabled"]
    }
  }
}
