{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prd-starter-state.schema.json",
  "title": "PRD Starter State File Schema v4.0",
  "description": "JSON schema for the prd-starter state file with Quick Start, Standard, and Expert modes including deep research and PM-generated PRD",
  "type": "object",
  "required": ["version", "startedAt", "currentPhase"],
  "properties": {
    "version": {
      "type": "string",
      "description": "State file version",
      "pattern": "^[34]\\.[0-9]+\\."
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the session started"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When the session completed"
    },
    "wizardMode": {
      "type": "string",
      "enum": ["quick-start", "standard", "expert"],
      "description": "Wizard configuration mode"
    },
    "selectedPreset": {
      "type": ["string", "null"],
      "enum": [
        "indie-game-dev",
        "game-studio",
        "mobile-game",
        "multiplayer-arena",
        "modern-web-app",
        "full-stack-saas",
        "dashboard-analytics",
        "content-platform",
        "ecommerce-store",
        "saas-product",
        "enterprise-suite",
        "api-server",
        "data-ml-pipeline",
        "devops-infrastructure",
        "custom",
        null
      ],
      "description": "Selected preset name (Quick Start mode)"
    },
    "presetCustomizations": {
      "type": "object",
      "description": "Customizations applied to preset",
      "properties": {
        "additionalSkills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "removedSkills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "additionalSubAgents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "removedSubAgents": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "currentPhase": {
      "type": "string",
      "enum": [
        "entry_point_selection",
        "preset_selection",
        "project_identity",
        "project_scope",
        "agent_configuration",
        "agent_definition",
        "agent_skills",
        "agent_subagents",
        "agent_workflow",
        "agent_files_generation",
        "skill_configuration",
        "subagent_configuration",
        "orchestration_configuration",
        "mcp_configuration",
        "quality_standards",
        "initial_features",
        "deep_research",
        "user_questions",
        "gdd_creation",
        "prd_creation",
        "final_review",
        "project_location_selection",
        "review_generate",
        "project_initialization",
        "completed"
      ],
      "description": "Current active phase"
    },
    "currentSubPhase": {
      "type": ["string", "null"],
      "description": "Current sub-phase for multi-step phases"
    },
    "customAgents": {
      "type": "array",
      "description": "Custom agent configurations (dynamic, N agents)",
      "items": {
        "$ref": "#/definitions/customAgentConfig"
      }
    },
    "project": {
      "type": "object",
      "description": "Project configuration",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Project name"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Project description"
        },
        "category": {
          "type": "string",
          "enum": [
            "game-development",
            "web-application",
            "mobile-app",
            "api-backend",
            "data-ml",
            "ecommerce",
            "saas",
            "devops-infrastructure",
            "other"
          ],
          "description": "Project category"
        },
        "customCategory": {
          "type": "string",
          "description": "Custom category if 'other' selected"
        },
        "techStack": {
          "type": "string",
          "description": "Primary technology stack"
        },
        "customTechStack": {
          "type": "string",
          "description": "Custom tech stack if 'Custom' selected"
        },
        "teamSize": {
          "type": "string",
          "enum": ["solo", "small-team", "medium-team", "enterprise"],
          "description": "Team size"
        },
        "projectScale": {
          "type": "string",
          "enum": ["prototype-mvp", "startup-product", "production-system"],
          "description": "Project scale"
        },
        "successFactors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "speed-to-market",
              "code-quality",
              "visual-excellence",
              "multiplayer-reliability",
              "mobile-performance",
              "accessibility",
              "seo-optimization",
              "real-time-features",
              "data-processing"
            ]
          },
          "description": "Critical success factors"
        }
      }
    },
    "projectLocation": {
      "type": "object",
      "description": "Target location for project generation",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["current", "subdirectory", "custom", "ralph-orchestra-root"],
          "description": "Location type"
        },
        "path": {
          "type": "string",
          "description": "Absolute or relative path to target directory"
        },
        "createSubdirectory": {
          "type": "boolean",
          "default": true,
          "description": "Whether to create a subdirectory with project name"
        },
        "subdirectoryName": {
          "type": "string",
          "description": "Name of subdirectory to create (defaults to project.name)"
        },
        "ralphOrchestraRoot": {
          "type": "string",
          "description": "Path to ralph-orchestra root (for reference during copy)"
        }
      }
    },
    "agents": {
      "type": "object",
      "description": "Agent configurations",
      "properties": {
        "pm": {
          "$ref": "#/definitions/agentConfig"
        },
        "developer": {
          "$ref": "#/definitions/agentConfig"
        },
        "techartist": {
          "$ref": "#/definitions/agentConfig"
        },
        "qa": {
          "$ref": "#/definitions/agentConfig"
        },
        "gamedesigner": {
          "$ref": "#/definitions/agentConfig"
        }
      }
    },
    "orchestration": {
      "type": "object",
      "description": "Orchestration settings",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["event-driven", "sequential", "polling", "hitl"],
          "description": "Orchestration mode"
        },
        "maxIterations": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000,
          "description": "Max iterations before auto-stop"
        },
        "contextResetThreshold": {
          "type": "integer",
          "default": 70,
          "minimum": 50,
          "maximum": 90,
          "description": "Context reset threshold percentage"
        }
      }
    },
    "qualityStandards": {
      "type": "object",
      "description": "Quality standards",
      "properties": {
        "typescriptStrictness": {
          "type": "string",
          "enum": ["strict", "standard", "loose"],
          "default": "strict"
        },
        "testCoverageTarget": {
          "type": "integer",
          "enum": [95, 80, 60, 0],
          "default": 80
        },
        "lintRules": {
          "type": "string",
          "enum": ["eslint-recommended", "custom", "none"],
          "default": "eslint-recommended"
        },
        "commitConvention": {
          "type": "string",
          "enum": ["ralph", "conventional", "custom"],
          "default": "ralph"
        },
        "cicdIntegration": {
          "type": "string",
          "enum": ["github-actions", "gitlab-ci", "none"],
          "default": "github-actions"
        },
        "noAnyTypes": {
          "type": "boolean",
          "default": true
        },
        "noTsIgnore": {
          "type": "boolean",
          "default": true
        },
        "allFeedbackLoopsMustPass": {
          "type": "boolean",
          "default": true
        },
        "visualRegressionTesting": {
          "type": "boolean",
          "default": false
        },
        "serverAuthoritativeValidation": {
          "type": "boolean",
          "default": false
        },
        "mobilePerformanceChecks": {
          "type": "boolean",
          "default": false
        },
        "accessibilityAuditing": {
          "type": "boolean",
          "default": false
        },
        "securityScanning": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "features": {
      "type": "array",
      "description": "Parsed PRD features",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^^(feat|fix|chore|test|arch|doc)-\\d+$"
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "enum": ["architectural", "functional", "integration", "chore", "design", "visual"]
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "agent": {
            "type": "string",
            "enum": ["pm", "developer", "techartist", "qa", "gamedesigner"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed"],
            "default": "pending"
          },
          "passes": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["id", "title", "description", "priority", "category", "agent"]
      }
    },
    "projectInitialization": {
      "type": "object",
      "description": "Project initialization state and configuration",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "failed", "skipped"],
          "default": "pending",
          "description": "Current initialization status"
        },
        "scriptPath": {
          "type": "string",
          "description": "Path to initialization script relative to project root"
        },
        "attempts": {
          "type": "integer",
          "default": 0,
          "maximum": 3,
          "description": "Number of initialization attempts made"
        },
        "maxAttempts": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of retry attempts"
        },
        "lastAttemptAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp of last initialization attempt"
        },
        "completedAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp when initialization completed successfully"
        },
        "error": {
          "type": ["string", "null"],
          "description": "Error message if initialization failed"
        },
        "errorDetails": {
          "type": ["string", "null"],
          "description": "Detailed error output for debugging"
        },
        "autoInitialize": {
          "type": "boolean",
          "default": true,
          "description": "Whether coordinator should auto-run initialization"
        },
        "techStack": {
          "type": "object",
          "description": "Technology stack configuration for initialization",
          "properties": {
            "runtime": {
              "type": "string",
              "enum": ["node", "python", "rust", "go", "java", "dotnet", "other"],
              "description": "Primary runtime environment"
            },
            "packageManager": {
              "type": "string",
              "description": "Package manager command (npm, yarn, pnpm, pip, poetry, cargo, go mod, etc.)"
            },
            "framework": {
              "type": "string",
              "description": "Framework name (react, vue, svelte, fastapi, django, etc.)"
            },
            "language": {
              "type": "string",
              "description": "Programming language (typescript, python, rust, go, etc.)"
            },
            "devCommand": {
              "type": "string",
              "description": "Command to start development server"
            },
            "buildCommand": {
              "type": "string",
              "description": "Command to build project"
            },
            "testCommand": {
              "type": "string",
              "description": "Command to run tests"
            },
            "installCommand": {
              "type": "string",
              "description": "Command to install dependencies"
            },
            "initCommand": {
              "type": "string",
              "description": "Command to initialize new project"
            }
          }
        },
        "feedbackLoops": {
          "type": "object",
          "description": "Feedback loop commands for quality checks",
          "properties": {
            "typeCheck": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            },
            "lint": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            },
            "test": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            },
            "build": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "researchData": {
      "type": "object",
      "description": "Data collected by pm-research-specialist during deep research phase",
      "properties": {
        "similarProjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" },
              "relevance": { "type": "string" }
            }
          }
        },
        "bestPractices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "practice": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "commonPitfalls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pitfall": { "type": "string" },
              "avoidance": { "type": "string" }
            }
          }
        },
        "techStackInsights": {
          "type": "object",
          "description": "Tech stack specific insights and recommendations"
        },
        "questionsAsked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "context": { "type": "string" },
              "impact": { "type": "string" }
            }
          }
        },
        "questionsAnswered": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" }
            }
          }
        },
        "recommendedRefinements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature": { "type": "string" },
              "refinement": { "type": "string" }
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "discoveredCommands": {
          "type": "object",
          "description": "Tech stack commands discovered by pm-research-specialist for unknown runtimes",
          "properties": {
            "runtime": {
              "type": "string",
              "description": "Discovered runtime name (e.g., 'elixir', 'zig', 'dart')"
            },
            "runtimeSource": {
              "type": "string",
              "enum": ["user", "preset", "research.web", "hardcoded"],
              "description": "Source of the runtime command discovery"
            },
            "discoveredAt": {
              "type": "string",
              "format": "date-time",
              "description": "When these commands were discovered"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"],
              "description": "Confidence level in the discovered commands"
            },
            "commands": {
              "type": "object",
              "description": "Discovered tech stack commands",
              "properties": {
                "packageManager": { "type": "string" },
                "init": { "type": "string" },
                "install": { "type": "string" },
                "dev": { "type": "string" },
                "build": { "type": "string" },
                "test": { "type": "string" },
                "typeCheck": { "type": "string" }
              }
            },
            "feedbackLoops": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Feedback loop commands for this runtime"
            },
            "discoverySources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": ["documentation", "github", "blog", "official", "other"]
                  },
                  "title": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "gddData": {
      "type": "object",
      "description": "Game Design Document data created by thermite facilitator (game projects only)",
      "properties": {
        "designDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^DEC-\\d+$" },
              "title": { "type": "string" },
              "decision": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^OQ-\\d+$" },
              "question": { "type": "string" },
              "priority": { "type": "string", "enum": ["high", "medium", "low"] }
            }
          }
        },
        "designPillars": {
          "type": "array",
          "items": { "type": "string" }
        },
        "coreMechanics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "thermiteSessionType": {
          "type": "string",
          "enum": ["boardroom-retreat", "deep-dive"]
        },
        "participants": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "prdSpecification": {
      "type": "object",
      "description": "Prepared specification for PM agent to create final PRD",
      "properties": {
        "refinedFeatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "priority": { "type": "string" },
              "category": { "type": "string" },
              "acceptanceCriteria": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": { "type": "string" },
              "dependsOn": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "priorities": {
          "type": "object",
          "description": "Priority assignments based on user goals and research"
        },
        "technicalRecommendations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "phases": {
      "type": "object",
      "description": "Legacy phase tracking (deprecated in v3.0 but kept for compatibility)"
    }
  },
  "definitions": {
    "agentConfig": {
      "type": "object",
      "description": "Individual agent configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether this agent is enabled"
        },
        "display_name": {
          "type": "string",
          "description": "Agent display name"
        },
        "role": {
          "type": "string",
          "enum": ["pm", "developer", "techartist", "qa", "gamedesigner"],
          "description": "Agent role type"
        },
        "primary_responsibility": {
          "type": "string",
          "description": "Primary responsibility statement"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of skill names"
        },
        "subAgents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of sub-agent names"
        },
        "mcpServers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["github", "filesystem", "web-search", "brave-search", "playwright", "vision", "blender", "shadertoy", "image-process"]
          },
          "description": "List of MCP server names"
        },
        "may_write": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths this agent may write to"
        },
        "may_not_write": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths this agent may not write to"
        },
        "cannot_do": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Things this agent cannot do"
        },
        "works_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other agents this works with"
        }
      },
      "required": ["enabled"]
    },
    "customAgentConfig": {
      "type": "object",
      "description": "Custom agent configuration for dynamic agent creation",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique agent ID (kebab-case)",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "description": "Human-readable name"
        },
        "agent_type": {
          "type": "string",
          "enum": ["pm", "developer", "techartist", "qa", "gamedesigner", "custom"],
          "description": "Base type for skill inheritance"
        },
        "custom_type_description": {
          "type": "string",
          "description": "Description of custom type"
        },
        "icon": {
          "type": "string",
          "description": "ASCII icon (3-6 lines, pipe-separated)"
        },
        "primary_responsibility": {
          "type": "string",
          "description": "Main focus area"
        },
        "main_activities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Key activities this agent performs"
        },
        "interaction_pattern": {
          "type": "string",
          "enum": ["coordinate", "collaborate", "autonomous", "receive-only", "send-only"],
          "description": "How this agent interacts with others"
        },
        "works_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other agent IDs this collaborates with"
        },
        "cannot_do": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Things this agent should not do"
        },
        "may_write": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths this agent may write to"
        },
        "may_not_write": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths this agent may not write to"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "action": {
                "type": "string",
                "enum": ["use_existing", "create_new"]
              }
            },
            "required": ["name", "action"]
          },
          "description": "Skills configuration"
        },
        "subAgents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "action": {
                "type": "string",
                "enum": ["use_existing", "create_new"]
              }
            },
            "required": ["name", "action"]
          },
          "description": "Sub-agents configuration"
        },
        "workflow": {
          "$ref": "#/definitions/workflowConfig"
        },
        "mcpServers": {
          "type": "array",
          "items": { "type": "string" },
